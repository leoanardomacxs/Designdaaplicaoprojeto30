generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./database.db"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") 
  createdAt DateTime @default(now())
  patients  Patient[]
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  age       Int
  status    String   @default("Active")
  condition String?  
  ownerId   String
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  records   Record[]
}

model Record {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) 

  
  systolic              Int?     
  diastolic             Int?     
  glucose               Int?     
  heart_rate            Int?     
  oxygen                Int?     
  temperature           Float?   

  
  weight                Float?   
  pain_level            Int?     
  pain_location         String?  
  fatigue               Boolean  @default(false) 
  dizziness             Boolean  @default(false) 
  edema                 Boolean  @default(false) 

  
  mobility              String   @default("Independente") 
  recent_falls          Boolean  @default(false)          
  difficulty_standing   Boolean  @default(false)          
  support_equipment     String?  

  
  oriented              Boolean  @default(true)  
  mental_confusion      Boolean  @default(false) 
  excessive_sleepiness  Boolean  @default(false) 
  speech_alteration     Boolean  @default(false) 

  
  appetite              String   @default("Normal") 
  food_intake           String   @default("Total")  
  water_intake          String   @default("Adequada") 
  difficulty_swallowing Boolean  @default(false)      

  
  urine                 String   @default("Normal") 
  feces                 String   @default("Normal") 
  incontinence          String   @default("Nenhuma") 

  
  mood                  String   @default("Estável") 
  activity_interest     Boolean  @default(true)     
  sleep_quality         String   @default("Normal") 

  notes                 String?  
} 